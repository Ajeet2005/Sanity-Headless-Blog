# ── BACKEND ENVIRONMENT TEMPLATE ──
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file — it contains secrets.

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
KHALTI_SECRET_KEY=<your-khalti-secret-key>
KHALTI_PUBLIC_KEY=<your-khalti-public-key>
BASE_URL=http://localhost:5000

# ── Firebase Cloud Messaging (Push Notifications) ──
# Public Firebase web config (safe to share):
FIREBASE_API_KEY=<your-firebase-web-api-key>
FIREBASE_AUTH_DOMAIN=<your-project>.firebaseapp.com
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_MESSAGING_SENDER_ID=<your-firebase-messaging-sender-id>
FIREBASE_APP_ID=<your-firebase-web-app-id>
# Service-account credentials — KEEP PRIVATE (backend only).
# From Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_CLIENT_EMAIL=<firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com>
# (Alternative: paste the whole service-account JSON here instead of the two fields above)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----\n"
# VAPID key (Firebase Console > Project settings > Cloud Messaging > Web Push certificates).
# Public — used by the browser to subscribe this device.
VAPID_PUBLIC_KEY=<your-vapid-public-key>
# Secret used to verify the Sanity webhook (same value as in Sanity webhook settings).
SANITY_WEBHOOK_SECRET=<a-long-random-secret>
